# .env

# Project settings
PROJECT_NAME=BackTestai
VERSION=0.1.0
API_V1_STR=/api/v1
DESCRIPTION=BackTestai - A powerful backtesting platform for trading strategies

# Security settings
SECRET_KEY=your_super_secret_key_here_please_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days
REFRESH_TOKEN_EXPIRE_MINUTES=43200  # 30 days
ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:3000"]
CORS_ORIGIN_REGEX=

# Database settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=456852
DB_NAME=backtest
TEST_DB_NAME=backtest_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT=30

# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Email settings
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=  # Commented out until email service is configured
# EMAILS_FROM_NAME=BackTestai
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48
EMAILS_ENABLED=false

# Development settings
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=app.log
ENABLE_DOCS=true
ENABLE_METRICS=true
ENABLE_TRACING=true

# Backtest settings
INITIAL_CASH=10000
COMMISSION=0.002
SLIPPAGE=0.0
RETRAIN_INTERVAL=100
MAX_DRAWDOWN=0.2

# Model settings
MODEL_DIR=models/
TIME_STEPS=60
HMM_COMPONENTS=3

# Data configuration
DATA_FILE=data.csv

# JWT settings
JWT_SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
